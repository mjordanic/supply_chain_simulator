# Copy to .env and fill in. The devcontainer passes these through from the host
# (see .devcontainer/devcontainer.json containerEnv). Only set what you use.

# Either an API key...
ANTHROPIC_API_KEY="sk-ant-......"
# ...or a Claude Code OAuth token (claude setup-token). One of the two is enough.
CLAUDE_CODE_OAUTH_TOKEN=""

# Optional — only if your project hits OpenAI.
OPENAI_API_KEY="sk-proj-......"
